{
    "compilerOptions": {
      "target": "ES2021",
      "lib": ["DOM", "ES2021"],
      "module": "none", // important
      "moduleResolution": "classic",
      "strict": true,
      "skipLibCheck": true,
      "declaration": false,
      "sourceMap": false,
      "outDir": "src-tauri/tsc",
      "rootDir": "src-ts"
    },
	"include": ["src-ts"],
	"exclude": ["node_modules", "src-tauri/tsc", "**/*.test.ts"]
  }