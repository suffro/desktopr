{
    "compilerOptions": {
      "target": "ES2021",
      "lib": ["DOM", "ES2021"],
      "module": "NodeNext", // important
      "moduleResolution": "nodenext",
      "strict": true,
      "skipLibCheck": true,
      "declaration": false,
      "sourceMap": false,
      "rootDir": "src-ts",
      "types": ["node"],
      "paths": {
        "@types": ["./src-ts/_types.ts"],
        "@helpers": ["./src-ts/_helpers.ts"],
        "@main": ["./src-ts/_main.ts"],
        "@constants": ["./src-ts/_constants.ts"],
      },
    },
	"include": ["src-ts"],
	"exclude": ["node_modules", "src-tauri/tsc", "**/*.test.ts"]
  }