{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["DOM", "ES2021"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "strict": true,
    "skipLibCheck": true,

    "declaration": true,
    "sourceMap": false,

    "outDir": "dist-sdk",
    "rootDir": "src-ts",

    "baseUrl": "./src-ts",
    "paths": {
      "@types": ["_types.ts"],
      "@helpers": ["_helpers.ts"],
      "@main": ["_main.ts"],
      "@constants": ["_constants.ts"]
    }
  },
  "include": [
    "src-ts/sdk/**/*",
    "src-ts/globals.d.ts"
  ],
  "exclude": [
    "node_modules",
    "src-tauri/tsc",
    "**/*.test.ts"
  ]
}