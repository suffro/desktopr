{
  "productName": "%%APP_NAME%%",
  "identifier": "%%APP_IDENTIFIER%%",
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": ["%%UPDATE_ENDPOINT%%"],
      "dialog": false,
      "pubkey": "%%ED25519_PUBKEY%%"
    },
    "deep-link": {
      "desktop": {
        "schemes": ["%%DEEPLINK_SCHEME%%"]
      }
    }
  },
  "build": { "removeUnusedCommands": true },
  "app": {
    "withGlobalTauri": true,
    "security": { "capabilities": ["remote"], "csp": null },
    "windows": [
      {
        "label": "main",
        "title": "%%MAIN_WINDOW_TITLE%%",
        "width": "%%MAIN_WINDOW_WIDTH%%",
        "height": "%%MAIN_WINDOW_HEIGHT%%",
        "backgroundColor": "%%MAIN_WINDOW_BG_COLOR%%",
        "resizable": true,
        "fullscreen": false,
        "url": "%%MAIN_WINDOW_URL%%"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": ["icons/icon.png"]
  }
}
