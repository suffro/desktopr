{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "{{APP_NAME}}",
    "version": "{{APP_VERSION}}",
    "identifier": "{{APP_ID}}",
    "build": {
      "removeUnusedCommands": true
    },
    "app": {
      "security": {
        "capabilities": ["core", "remote", "plugins"]
      },
      "windows": [
        {
          "label": "main",
          "title": "{{APP_NAME}}",
          "backgroundColor": "#171717",
          "width": 1200,
          "height": 800,
          "resizable": true,
          "fullscreen": false,
          "url": "{{APP_URL}}"
        }
      ]
    },
    "bundle": {
      "active": true,
      "targets": ["msi", "dmg", "appimage"],
      "icon": [
        "icons/16x16.png",
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/256x256.png",
        "icons/512x512.png",
        "icons/1024x1024.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "createUpdaterArtifacts": false
    },
    "plugins": {
      "updater": {
        "pubkey": "{{UPDATER_PUBKEY}}",
        "endpoints": ["{{UPDATER_ENDPOINT}}"]
      }
    }
  }
  