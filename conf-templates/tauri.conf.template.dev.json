{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desktopr dev",
  "version": "0.2.1",
  "identifier": "app.desktopr.dashboard",
  "plugins": {
    "updater": {
      "active": false
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "desktopr"
        ]
      }
    }
  },
  "build": {
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "remote"
      ],
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Desktopr Dev",
        "visible": false,
        "devtools": true,
        "width": 1200,
        "height": 800,
        "backgroundColor": "#171717",
        "resizable": true,
        "fullscreen": false,
        "url": "https://companion.desktopr.app"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  }
}
