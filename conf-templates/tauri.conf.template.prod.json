{
  "productName": "%%APP_NAME%%",
  "identifier": "%%APP_IDENTIFIER%%",
  "version": "%%APP_VERSION%%",

  "build": { "removeUnusedCommands": true },

  "app": {
    "withGlobalTauri": true,
    "security": { "capabilities": ["remote"], "csp": null },
    "windows": [
      {
        "label": "main",
        "title": "%%MAIN_WINDOW_TITLE%%",
        "devtools": false,
        "width": "%%MAIN_WINDOW_WIDTH%%",
        "height": "%%MAIN_WINDOW_HEIGHT%%",
        "backgroundColor": "%%MAIN_WINDOW_BG_COLOR%%",
        "resizable": "%%MAIN_WINDOW_RESIZABLE%%",
        "visible": false,
        "fullscreen": "%%MAIN_WINDOW_OPEN_FULLSCREEN%%",
        "url": "%%MAIN_WINDOW_URL%%"
      }
    ]
  },

  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "deb", "rpm", "appimage"],
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "active": false
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "desktopr"
        ]
      }
    }
  }
}