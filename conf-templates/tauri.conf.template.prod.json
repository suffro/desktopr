{
  "productName": "%%APP_NAME%%",
  "identifier": "%%APP_IDENTIFIER%%",
  "version": "%%APP_VERSION%%",

  "build": {
    "frontendDist": ["standalone/index.html"],
    "removeUnusedCommands": true
  },

  "app": {
    "withGlobalTauri": true,
    "security": { "capabilities": ["remote"], "csp": null },
    "windows": []
  },

  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "rpm", "appimage"],
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "desktopr"
        ]
      }
    }
  }
}
