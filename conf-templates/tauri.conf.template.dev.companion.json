{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bubbledesk Companion",
  "version": "0.2.1",
  "identifier": "app.bubbledesk.companion",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "bubbledesk-companion"
        ]
      }
    },
    "updater": {
      "active": false
    }
  },
  "build": {
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": ["remote"],
      "csp": null
    },
    "windows": [
      {
        "label": "companion",
        "title": "Bubbledesk Companion",
        "visible": false,
        "width": 1200,
        "height": 800,
        "backgroundColor": "#171717",
        "resizable": true,
        "fullscreen": false,
        "url": "./blank.html"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "resources": [],
    "icon": [
      "icons/icon.png"
    ]
  }
}