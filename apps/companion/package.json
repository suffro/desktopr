{
	"name": "@desktopr/companion",
	"private": true,
	"version": "0.0.0",
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"generate:types": "node scripts/generate-desktopr-playground-types.mjs",
		"build": "npm run sdk:build --prefix ../.. && npm run generate:types && vite build",
		"check": "npm run sdk:build --prefix ../.. && npm run generate:types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"prepare": "svelte-kit sync || echo ''",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.48.5",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.17",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.43.8",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.1.17",
		"vite": "^7.2.2"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.2",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/language": "^6.12.3",
		"@codemirror/lint": "^6.9.6",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.43.0",
		"@lezer/highlight": "^1.2.3",
		"@typescript/vfs": "^1.6.4",
		"codemirror": "^6.0.2",
		"comlink": "^4.4.2",
		"desktopr": "*",
		"typescript": "^5.9.3"
	}
}
