{
  "identifier": "remote",
  "windows": ["*"],
  "remote": { "urls": ["https://dashboard.bubbledesk.app"], "ipc": true },
  "permissions": [
    "core:default",

    "notification:default",
    "notification:allow-permission-state",
    "notification:allow-request-permission",
    "notification:allow-is-permission-granted",
    "notification:allow-notify",
    "notification:allow-show",

    "clipboard:default",
    "clipboard:allow-read-text",
    "clipboard:allow-write-text",

    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
