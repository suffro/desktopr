{
  "enabled": true,
  "platforms": ["macos", "windows", "linux"],
  "file": {
    "section": "file",
    "items": [
      {
        "type": "custom",
        "id": "file.new",
        "label": "New File",
        "enabled": true,
        "interaction": "click"
      },
      {
        "type": "custom",
        "id": "file.open",
        "label": "Open File...",
        "enabled": true,
        "interaction": "click"
      },
      { "type": "separator" },
      {
        "type": "predefined",
        "item": "close_window"
      },
      {
        "type": "predefined",
        "item": "quit"
      }
    ]
  },
  "edit": {
    "section": "edit",
    "items": [
      { "type": "predefined", "item": "copy" },
      { "type": "predefined", "item": "cut" },
      { "type": "predefined", "item": "paste" },
      { "type": "predefined", "item": "select_all" }
    ]
  },
  
  "view": {
    "section": "view",
    "items": [
      {
        "type": "custom",
        "id": "view.reload",
        "label": "Reload",
        "enabled": true,
        "interaction": "click",
        "accelerator": "CmdOrCtrl+R"
      },
      {
        "type": "custom",
        "id": "view.devtools",
        "label": "Toggle DevTools",
        "enabled": true,
        "interaction": "check",
        "checked": false,
        "accelerator": "CmdOrCtrl+Alt+I"
      },
      { "type": "separator" },
      {
        "type": "submenu",
        "label": "Language",
        "id": "view.lang",
        "items": [
          { "type": "custom", "id": "view.lang.en", "label": "English",  "enabled": true, "interaction": "check" },
          { "type": "custom", "id": "view.lang.it", "label": "Italiano", "enabled": true, "interaction": "check" }
        ]
      }
    ]
  },
  "window": {
    "section": "window",
    "items": [
      { "type": "predefined", "item": "minimize" },
      { "type": "predefined", "item": "maximize" },
      { "type": "predefined", "item": "close_window" }
    ]
  },
  "macosRoot": {
    "section": "macosRoot",
    "items": [
      { "type": "predefined", "item": "about", "customLabel": "About MyApp" },
      { "type": "separator" },
      { "type": "predefined", "item": "services" },
      { "type": "separator" },
      { "type": "predefined", "item": "hide" },
      { "type": "predefined", "item": "hide_others" },
      { "type": "predefined", "item": "show_all" },
      { "type": "separator" },
      { "type": "predefined", "item": "quit" }
    ]
  },
  "tray": {
    "section": "tray",
    "items": [
      { "type": "separator" },
      { "type": "custom", "id": "tray.custom.settings", "label": "Settings", "enabled": true, "interaction": "click" }
    ]
  }  
}
