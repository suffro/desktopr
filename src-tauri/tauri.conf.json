{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bubbledesk Companion",
  "version": "0.2.1",
  "identifier": "app.bubbledesk.dashboard",
  "plugins": {
    "updater": {
      "active": false
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "bubbledesk"
        ]
      }
    }
  },
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "remote"
      ],
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Bubbledesk Companion",
        "visible": false,
        "width": 1200,
        "height": 800,
        "backgroundColor": "#171717",
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg"
    ],
    "icon": [
      "icons/icon-companion.png"
    ]
  }
}
