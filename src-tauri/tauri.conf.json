{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desktopr dev",
  "version": "0.2.1",
  "identifier": "app.desktopr.dev",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "desktopr"
        ]
      }
    }
  },
  "build": {
    "frontendDist": [
      "standalone/index.html"
    ],
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "remote"
      ],
      "csp": null
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  }
}
