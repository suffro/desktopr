<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for App Store / notarization -->
  <key>com.apple.security.app-sandbox</key>
  <false/>

  <!-- Allows outbound network connections (needed for remote webview URL) -->
  <key>com.apple.security.network.client</key>
  <true/>

  <!-- Do not add restricted com.apple.developer.* entitlements here: they need a
       provisioning profile, and macOS refuses to launch unsigned or ad-hoc signed
       builds that declare them. -->
</dict>
</plist>
